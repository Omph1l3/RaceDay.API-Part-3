@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />

    <!-- Sporty Font from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f4f7f6; /* Subtle off-white background */
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .navbar {
            border-bottom: 4px solid #ffc107; /* Yellow accent line */
        }
        .navbar-brand {
            font-weight: 800;
            letter-spacing: 1px;
            color: #ffc107 !important; /* Gold/Yellow brand color */
        }
        .nav-link {
            font-weight: 600;
            transition: color 0.2s ease-in-out;
        }
        .nav-link:hover {
            color: #ffc107 !important;
        }
        main {
            flex: 1; /* Pushes footer to the bottom */
        }
        .footer {
            background-color: #212529;
            color: #adb5bd !important;
        }
        .footer a {
            color: #ffc107;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fs-4" asp-area="" asp-controller="Home" asp-action="Index">🏃‍♂️ RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (Context.Session.GetString("JWToken") == null)
                        {
                            <!-- Not logged in -->
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                        else
                        {
                            <!-- Logged in -->
                            var role = Context.Session.GetString("UserRole");

                            if (role == "Organiser")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Organiser" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-bold" asp-controller="Events" asp-action="Create">+ Create Event</a>
                                </li>
                            }
                            else if (role == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Enrolments" asp-action="MyEnrolments">My Enrolments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Enrolments" asp-action="MyResults">My Results</a>
                                </li>
                            }
                        }
                    </ul>

                    @if (Context.Session.GetString("JWToken") != null)
                    {
                        <!-- Logout Button (Moved to the right) -->
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold mt-2 mt-lg-0">Logout</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-auto py-3 border-top">
        <div class="container text-center">
            &copy; 2026 - RaceDay - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>